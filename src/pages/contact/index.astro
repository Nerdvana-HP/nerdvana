---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Form from '../../components/Form.astro';
import { getSingleton } from '../../lib/content';

const data = await getSingleton('contact');
const { contact } = await getSingleton('siteSettings');
const email = contact.email.trim();
const phone = contact.phone.trim();
---

<BaseLayout title={data.seo.title} description={data.seo.description}>
  <Hero {...data.hero} />
  <Section heading={data.form.heading} intro={data.form.intro}>
    <Form labels={data.form} />
  </Section>
  {(email || phone) && (
    <Section heading={data.direct.heading} intro={data.direct.intro} muted>
      <address class="grid gap-2xs not-italic">
        {email && <a href={`mailto:${email}`}>{email}</a>}
        {phone && <a href={`tel:${phone.replace(/[^\d+]/g, '')}`}>{phone}</a>}
      </address>
    </Section>
  )}
</BaseLayout>
